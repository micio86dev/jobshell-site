---
import '../styles/global.css';
import { APP, LOCALES, type Locale } from '../config';
import { messages } from '../i18n/messages';
import Logo from '../components/Logo.astro';

interface Props {
  locale: Locale;
  title: string;
  description: string;
  path: string;
}
const { locale, title, description, path } = Astro.props;
const t = messages[locale];
const canonical = new URL(`/${locale}${path}`, Astro.site ?? 'https://jobshell.dev').href;
const image = new URL('/og.png', Astro.site ?? 'https://jobshell.dev').href;
const structured = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: APP.name,
    description,
    url: canonical,
    inLanguage: locale,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'macOS, Windows, Linux',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
    license: 'https://www.apache.org/licenses/LICENSE-2.0',
    codeRepository: APP.repoUrl,
    keywords: 'job search, CV matching, developers, open source',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: APP.name,
    url: canonical,
    inLanguage: LOCALES,
  },
];
const languageNames: Record<Locale, string> = { en: 'English', it: 'Italiano', es: 'Español' };
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={APP.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : locale === 'it' ? 'it_IT' : 'es_ES'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <script type="application/ld+json" set:html={JSON.stringify(structured)} />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f7f8fb" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1d2026" />
    {LOCALES.map((l) => <link rel="alternate" hreflang={l} href={`/${l}${path}`} />)}
    <link rel="alternate" hreflang="x-default" href={`/en${path}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <div class="wrap">
      <header class="top">
        <a class="brand" href={`/${locale}/`}>
          <Logo size={34} />
          <span>{APP.name}</span>
        </a>
        <nav aria-label={t.language} class="langs">
          {LOCALES.map((l) => (
            <a href={`/${l}${path}`} hreflang={l} lang={l} title={languageNames[l]} aria-current={l === locale ? 'page' : undefined}>{l.toUpperCase()}</a>
          ))}
        </nav>
      </header>
      <main id="main" tabindex="-1">
        <slot />
      </main>
      <footer class="foot">
        <p>{t.openSource} <a href={APP.repoUrl}>{t.sourceLink}</a></p>
        <p><a href={`/${locale}/privacy/`}>{t.privacyLink}</a></p>
      </footer>
    </div>
  </body>
</html>
