---
// The mark: a search lens over a terminal prompt, the job search seen from the code side.
interface Props {
  size?: number;
}
const { size = 40 } = Astro.props;
---
<svg class="logo" width={size} height={size} viewBox="0 0 48 48" role="img" aria-label="Jobshell" focusable="false">
  <rect x="1" y="1" width="46" height="46" rx="12" class="logo-tile" />
  <g transform="translate(0.5 0.5)">
    <circle cx="21" cy="21" r="9.5" class="logo-lens" />
    <path d="M28.5 28.5 L35.5 35.5" class="logo-handle" />
    <path d="M16.5 18 L19.5 21 L16.5 24" class="logo-prompt" />
    <path d="M21.5 24 L25 24" class="logo-prompt" />
  </g>
</svg>
<style>
  .logo { display: block; flex: none; }
  .logo-tile { fill: var(--accent); }
  .logo-lens, .logo-handle, .logo-prompt {
    fill: none;
    stroke: var(--accent-fg);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
