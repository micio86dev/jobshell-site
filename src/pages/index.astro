---
// Sends the visitor to the closest language they read. Nothing is stored and no cookie is set.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Jobshell</title>
    <script is:inline>
      // The language a visitor chose wins; otherwise the browser's languages; otherwise English.
      const supported = ['en', 'it', 'es'];
      const saved = (document.cookie.match(/(?:^|; )jobshell_lang=(en|it|es)(?:;|$)/) || [])[1];
      const wanted = (navigator.languages || [navigator.language || 'en']).map((l) => l.slice(0, 2).toLowerCase());
      const match = saved || wanted.find((l) => supported.includes(l)) || 'en';
      location.replace('/' + match + '/');
    </script>
  </head>
  <body>
    <p>
      <a href="/it/">Italiano</a> · <a href="/es/">Español</a> · <a href="/en/">English</a>
    </p>
  </body>
</html>
